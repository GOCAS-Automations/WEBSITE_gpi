# =============================================================================
# GPI — Variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` (ignorado por git) y rellena los valores.
#
#   cp .env.example .env.local
#
# El sitio FUNCIONA SIN estas variables: en ese caso el contenido sale de
# `src/data/*` (fallback estático) y /mi-cuenta muestra el aviso de
# "próximamente". Con las variables configuradas se activan Supabase, el login
# y el panel /admin.
#
# Dónde encontrarlas:
#   Dashboard de Supabase → proyecto "GPI Project" → Settings → API Keys
#     - NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#     - NEXT_PUBLIC_SUPABASE_ANON_KEY = clave pública "anon" / "publishable"
#
# IMPORTANTE: nunca pongas aquí la "service_role key" — es secreta y este sitio
# no la necesita (todo pasa por RLS).
#
# En Vercel: Project → Settings → Environment Variables → añade las dos con el
# mismo nombre para Production, Preview y Development, y vuelve a desplegar.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
